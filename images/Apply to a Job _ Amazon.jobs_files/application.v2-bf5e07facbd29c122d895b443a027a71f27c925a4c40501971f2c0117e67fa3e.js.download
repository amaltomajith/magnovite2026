lp prepare for upcoming assessments, phone screens, and interview loops for various technical and non-technical roles.",description:"We want to make sure you\u2019re prepared when it\u2019s time to interview. Explore our curated list of interview prep materials.",title:"Interview resources"},job_finder:{footer:{equal_opportunity:"Amazon is committed to a diverse and inclusive workplace. Amazon is an equal opportunity employer and does not discriminate on the basis of race, national origin, gender, gender identity, sexual orientation, protected veteran status, disability, age, or other legally protected status. For individuals with disabilities who would like to request an accommodation, please visit https://www.amazon.jobs/en/disability/us.",faq:"JobFinder FAQ",feedback:"Have a suggestion?",gdpr:{copyright:"\xa9 1996-%{current_year}, Amazon.com, Inc or its affiliates",disclaimer_html:'We know that you care how we use information about you and we appreciate your trust in us to do that carefully and sensibly. Please consult our <a href=\'%{privacy_us_link}\' target=\'_blank\' class="footer-link" rel="noopener noreferrer" data-direct-call-identifier="footer_privacy">Privacy Notice</a> to know more about how we collect, use and transfer the personal data of our candidates',impressum:"Impressum","privacy-notice":"Privacy Notice"},give_us_feedback_link:"Give us feedback",help:"Need help?",privacy:"Privacy and Data"},menu:{applications:"Applications",profile:"Profile",referrals:"Referrals"}},job_na:"N/A",job_not_found:"Job Not Found",job_title:"%{job_title} (L%{job_level})",job_title_with_job_id:"%{job_title} (ID: %{job_id})",jobfinder:"JobFinder",jobs:{id:"Job ID: %{job_id}"},jobs_header:{logo_url:"https://amazon.jobs"},languages:{cs:"\u010ce\u0161tina",de:"Deutsch",en:"English","en-gb":"English, British",es:"Espa\xf1ol, Espa\xf1a",fr:"Fran\xe7ais",it:"Italiano",jp:"\u65e5\u672c\u8a9e",pl:"Polski",pt:"Portugu\xeas, Brasil",zh:"\u7b80\u4f53\u4e2d\u6587"},loading:"Please wa