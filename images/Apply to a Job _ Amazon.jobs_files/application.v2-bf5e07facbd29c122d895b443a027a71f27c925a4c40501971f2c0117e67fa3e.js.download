isability/Vet",feedback:{modal:{amazon_order:{link_text:"Amazon's Customer Service",no_response_note:"If you need help with an Amazon order or product, or have a general question about Amazon, please visit %{link}.",submit_button:"Take me there",title:"Get help with an Amazon order"},cancel_button:"Cancel",cs_link_text:"Amazon's Customer Service",customer_service_role:{link_text:"our FAQs page",no_response_note:"We know you've got questions, and we're here to help. Please visit %{link} to find information on our hiring process and more.",submit_button:"Take me there",title:"Get help with hourly customer service roles"},email_placeholder:"Your email address (optional)",failure_title:"Oh dear, something went wrong.",failure_title_sub:"We're sorry, but we can't submit your feedback right now. Please try again later.",faqs_link:{link_text:"read our FAQs",no_response_note:"Please %{link} before submitting your feedback. Due to the volume of feedback we receive, we\u2019re unable to respond to individual requests."},feedback_placeholder:"Enter your message",fulfillment_role:{link_text:"our FAQs page",no_response_note:"We know you've got questions, and we're here to help. Please visit %{link} to find information on our hiring process and more.",submit_button:"Take me there",title:"Get help with hourly fulfillment roles"},name_placeholder:"Your name (optional)",submit_button:"Submit feedback",success_message:"Your feedback has been sent.",success_title:"Thanks!",title:"Your feedback or questions",validation_message_suggestion:"Please enter a message"},ticket:{categories:{amazon_order:"Question about my Amazon.com order or product",bugs:"Technical problem with this site",customer_service_role:"Question about an hourly customer service role",default:"Please choose a feedback type",fulfillment_role:"Question about an hourly fulfillment role",general_feedback:"Idea or suggestion for the Amazon.jobs site",general_questions:"General question on an item not listed here"},subject:"